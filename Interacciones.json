{
  "elisa_config": {
    "intenciones": [
      {
        "id": "saludo",
        "patrones_regex": ["(?i)^(hola|buenas|qué tal|hey|saludos|inicio)"],
        "descripcion": "El usuario inicia la conversación"
      },
      {
        "id": "despedida",
        "patrones_regex": ["(?i)^(adiós|gracias por todo|bye|hasta luego|nos vemos|chao)"],
        "descripcion": "El usuario termina la conversación"
      },
      {
        "id": "agradecimiento",
        "patrones_regex": ["(?i)(gracias|te lo agradezco|excelente servicio|muy amable)"],
        "descripcion": "El usuario agradece la información"
      },
      {
        "id": "cortesia",
        "patrones_regex": ["(?i)(cómo estás|cómo te va|qué tal tu día)"],
        "descripcion": "Interacción social y empatía"
      },
      {
        "id": "horario",
        "patrones_regex": ["(?i)(horario|abre|abierto|cierran|días.*(abre|abierto)|a qué hora)"],
        "descripcion": "Pregunta por días y horas de apertura"
      },
      {
        "id": "precio",
        "patrones_regex": ["(?i)(precio|cuesta|entrada|boleto|cuánto.*(cuesta|vale))"],
        "descripcion": "Pregunta por el costo de entrada"
      },
      {
        "id": "descuento",
        "patrones_regex": ["(?i)(descuento|estudiante|credencial|inapam|maestro)"],
        "descripcion": "Pregunta por descuentos o tarifas reducidas"
      },
      {
        "id": "domingo_gratis",
        "patrones_regex": ["(?i)(domingo.*gratis|gratis.*domingo|entrada libre.*domingo)"],
        "descripcion": "Pregunta si el domingo es gratis para mexicanos"
      },
      {
        "id": "transporte",
        "patrones_regex": ["(?i)(cómo llego|como llego|metro|metrobús|transporte|ubicación|dónde está|direccion)"],
        "descripcion": "Pregunta por ubicación o transporte cercano"
      },
      {
        "id": "expo_temporal",
        "patrones_regex": ["(?i)(expo|exposición).*(temporal|actual|ahorita|ahora)"],
        "descripcion": "Pregunta por exposiciones temporales vigentes"
      },
      {
        "id": "comida",
        "patrones_regex": ["(?i)(comer|comida|dónde como|restaurante|antojo)"],
        "descripcion": "Pregunta por opciones de comida cercanas"
      },
      {
        "id": "actividades",
        "patrones_regex": ["(?i)(taller|actividad|evento|lúdico)"],
        "descripcion": "Pregunta por talleres, actividades o eventos"
      },
      {
        "id": "guias",
        "patrones_regex": ["(?i)(guía|guia|recorrido guiado|visita guiada)"],
        "descripcion": "Pregunta si hay guías o visitas programadas"
      },
      {
        "id": "duracion",
        "patrones_regex": ["(?i)(cuánto.*(dura|tarda)|duración|tiempo.*(recorrer|visitar))"],
        "descripcion": "Pregunta cuánto dura el recorrido"
      },
      {
        "id": "recomendaciones",
        "patrones_regex": ["(?i)(qué me pongo|qué llevar|recomendación|ropa|vestimenta)"],
        "descripcion": "Pregunta por recomendaciones de vestimenta o qué llevar"
      },
      {
        "id": "restricciones",
        "patrones_regex": ["(?i)(prohibido|no se permite|puedo tomar fotos|se puede tocar)"],
        "descripcion": "Pregunta por lo que no está permitido"
      },
      {
        "id": "filtro_categoria",
        "patrones_regex": ["(?i)(museo.*(arte|historia|ciencia|interactivo)|de qué tipo)"],
        "descripcion": "Filtra museos por categoría"
      },
      {
        "id": "filtro_edad",
        "patrones_regex": ["(?i)(niños|infantil|familia|para adultos)"],
        "descripcion": "Filtra museos por edad recomendada"
      }
    ],
    "respuestas_estaticas": {
      "saludo": [
        "¡Hola! Soy Elisa, tu asistente de museos en la CDMX. ¿En qué te puedo ayudar hoy?",
        "¡Buenas! Puedo darte recomendaciones sobre museos, costos o ubicaciones. ¿Qué buscas?"
      ],
      "despedida": [
        "¡Hasta luego! Que disfrutes mucho tu visita a los museos.",
        "¡Nos vemos! Regresa cuando necesites más recomendaciones."
      ],
      "agradecimiento": [
        "¡De nada! Es un placer ayudarte.",
        "¡Por nada! ¿Hay algún otro museo sobre el que quieras consultar?"
      ],
      "cortesia": [
        "¡Todo bien por aquí, lista para ayudarte a planear tu ruta cultural! ¿Qué tipo de museo te gustaría visitar?"
      ]
    }
  }
